#!/usr/bin/env bash
# PlatformIO 包装器：显式固定 core dir，不依赖交互 shell 的环境变量。
# 用 `python -m platformio` 而不是 .venv/bin/pio，这样整个 esp/ 目录可以整体搬移，
# 不会因为 console script 的 shebang 写死了旧路径而失效。
set -e
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PLATFORMIO_CORE_DIR="$here/.pio-core"
exec "$here/.venv/bin/python" -m platformio "$@"
